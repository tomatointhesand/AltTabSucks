[Unit]
Description=AltTabSucks toast overlay daemon
# See alttabsucks-server.service's own comment for the full story — the short version: After=
# alone doesn't reliably order this against graphical-session.target unless [Install] below also
# points at graphical-session.target (not default.target), since only then does this service get
# pulled into the same startup transaction that After= can actually order within.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=LD_PRELOAD=YOUR_GTK4_LAYER_SHELL_SO
ExecStart=/usr/bin/python3 YOUR_REPO_ROOT/linux/toast/alttabsucks_toast.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
