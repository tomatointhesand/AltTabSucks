#!/usr/bin/env bash
# Regenerate sanitized templates before every commit.
# Only runs if the gitignored source files exist on disk.
# make-template.sh is fast (sed only), so this adds negligible overhead.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
LINUX_CODE_DIR="$REPO_ROOT/linux/kwin/alttabsucks/contents/code"

if [ -f "$REPO_ROOT/lib/app-hotkeys.ahk" ] || [ -f "$REPO_ROOT/lib/config.ahk" ] \
   || [ -f "$LINUX_CODE_DIR/hotkeys.js" ]; then
    echo "[pre-commit] Regenerating templates..."
    bash "$REPO_ROOT/dev-scripts/make-template.sh"
    git add "$REPO_ROOT/lib/app-hotkeys.template.ahk" "$REPO_ROOT/lib/config.template.ahk" \
            "$LINUX_CODE_DIR/hotkeys.template.js"
fi

# hotkeys.template.js is unsanitized (see .gitignore's own comment on
# why) — nothing redacts a credential accidentally pasted into a binding's argv/urlPatterns/etc.
# the way the AHK sensitive-section sanitizer does below, so this scans the whole staged diff
# instead of just a marked-off section. Same "block the commit" response as the AHK check, no
# concept of a sensitive section to scope down to here since the whole file ships unsanitized.
for template in "$LINUX_CODE_DIR/hotkeys.template.js"; do
    if [ -f "$template" ]; then
        staged_added_lines="$(git diff --cached -- "$template" | grep '^+[^+]' | cut -c2- || true)"
        if [ -n "$staged_added_lines" ] && printf '%s\n' "$staged_added_lines" \
                | grep -Eiq '\b(password|passwd|api[_-]?key|secret|token|auth)\b[[:space:]]*[:=]'; then
            echo "[pre-commit] Blocked: potential hardcoded credential detected in $(basename "$template")."
            echo "[pre-commit] hotkeys.js is copied into its template unsanitized —"
            echo "[pre-commit] nothing resembling a credential should ever go in a binding."
            exit 1
        fi
    fi
done

if [ -f "$REPO_ROOT/lib/app-hotkeys.ahk" ]; then
    staged_sensitive_lines="$(git diff --cached -- "$REPO_ROOT/lib/app-hotkeys.ahk" | awk '
        /^\+[^+]/ {
            line = substr($0, 2)
            if (line ~ /^;--- BEGIN SENSITIVE ---/) { in_sensitive = 1; next }
            if (line ~ /^;--- END SENSITIVE ---/)   { in_sensitive = 0; next }
            if (in_sensitive) { print line }
        }
    ')"

    if [ -n "$staged_sensitive_lines" ] && printf "%s\n" "$staged_sensitive_lines" | grep -Eiq 'Send\(".+"\)|\<(PuttyUser|Password|Pass|Token|ApiKey|Secret)\>[[:space:]]*:=[[:space:]]*"'; then
        echo "[pre-commit] Blocked: potential hardcoded secret detected in lib/app-hotkeys.ahk sensitive section."
        echo "[pre-commit] Keep credentials out of app-hotkeys.ahk entirely rather than as literals."
        exit 1
    fi
fi
